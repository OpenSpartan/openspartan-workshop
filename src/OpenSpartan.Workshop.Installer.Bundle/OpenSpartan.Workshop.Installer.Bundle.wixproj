<Project Sdk="WixToolset.Sdk/4.0.4">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>

    <!-- Default to x64 when no platform is supplied (e.g. local `dotnet build`).
         Pass -p:Platform=x64|ARM64|x86 to target a specific architecture. -->
    <HostArchitecture Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</HostArchitecture>
    <HostArchitecture Condition="'$(HostArchitecture)' == ''">$(Platform)</HostArchitecture>

    <!-- Lowercase form for runtime installer file names and netfx Platform attributes. -->
    <NetFxArchitecture>$(HostArchitecture.ToLower())</NetFxArchitecture>

    <DefineConstants>$(DefineConstants);HostArchitecture=$(HostArchitecture);NetFxArchitecture=$(NetFxArchitecture);</DefineConstants>

    <!-- Per-arch bundle filename so the GitHub release can publish all three side by side. -->
    <OutputName>OpenSpartan.Workshop.Installer.Bundle-$(HostArchitecture)</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Resources\Images\logo-icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.4" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="4.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenSpartan.Workshop.Installer\OpenSpartan.Workshop.Installer.wixproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Dependencies\WindowsAppRuntimeInstall-$(NetFxArchitecture).exe" />
    <None Include="Dependencies\windowsdesktop-runtime-10.0.0-win-$(NetFxArchitecture).exe" />
  </ItemGroup>
</Project>
