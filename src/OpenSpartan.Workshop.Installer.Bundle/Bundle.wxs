<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	 xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
	 xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

	<Bundle Name="OpenSpartan Workshop ($(var.HostArchitecture))" Manufacturer="Den Delimarsky" Version="1.0.12.0" UpgradeCode="cf3576f5-2f23-4095-94b9-c6c44e6b4891">
		<netfx:DotNetCoreSearchRef Id="SearchForDotNet10" />

		<BootstrapperApplication>
			<bal:WixStandardBootstrapperApplication LicenseUrl="https://raw.githubusercontent.com/OpenSpartan/openspartan-workshop/master/LICENSE" Theme="hyperlinkLicense" LogoFile="Resources\Images\logo-icon.png" />
		</BootstrapperApplication>

		<Chain>
			<PackageGroupRef Id="Prerequisites" />
			<PackageGroupRef Id="OpenSpartanWorkshopPackages" />
		</Chain>
	</Bundle>

	<Fragment>
		<!-- Apps use .NET 10 desktop runtime, architecture-matched to the host. -->
		<netfx:DotNetCoreSearch Id="SearchForDotNet10" RuntimeType="desktop" MajorVersion="10" Platform="$(var.NetFxArchitecture)" Variable="DOTNETDESKTOPVERSION"/>

		<PackageGroup Id="Prerequisites">
			<ExePackage
				DisplayName="Microsoft .NET 10 Desktop Runtime ($(var.HostArchitecture))"
				SourceFile="Dependencies\windowsdesktop-runtime-10.0.0-win-$(var.NetFxArchitecture).exe"
				Permanent="true"
				Compressed="true"
				Vital="true"
				UninstallArguments="/uninstall /passive /norestart /quiet"
				DetectCondition="DOTNETDESKTOPVERSION &gt;= &quot;10.0.0&quot;"
				InstallArguments="/install /passive /norestart /log openspartan.workshop.net10install.log"
                />
			<!-- WindowsAppRuntimeInstall.exe does not accept a log-file flag; -q is the only diagnostics knob. -->
			<ExePackage
				DisplayName="Microsoft Windows App Runtime 1.8 ($(var.HostArchitecture))"
				SourceFile="Dependencies\WindowsAppRuntimeInstall-$(var.NetFxArchitecture).exe"
				Compressed="true"
				InstallArguments="-q"
				Permanent="true"
				Vital="true"
                />
		</PackageGroup>

		<PackageGroup Id="OpenSpartanWorkshopPackages">
			<MsiPackage
				Id="OpenSpartanWorkshopSetup"
				Vital="yes"
				Permanent="no"
				Compressed="yes"
				SourceFile="OpenSpartan.Workshop.Installer.msi">
			</MsiPackage>
		</PackageGroup>
	</Fragment>
</Wix>
